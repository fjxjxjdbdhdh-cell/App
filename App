def get_simulated_price(symbol: str) -> dict:
    base_prices = {
        "EURUSD": 1.0850, "GBPUSD": 1.2650, "USDJPY": 149.50,
        "AUDUSD": 0.6550, "USDCAD": 1.3650, "USDCHF": 0.8950,
        "NZDUSD": 0.6050, "EURGBP": 0.8580, "EURJPY": 162.20,
        "GBPJPY": 189.50, "XAUUSD": 2050.0, "XAGUSD": 23.50,
        "BTCUSD": 43000.0, "ETHUSD": 2500.0, "LTCUSD": 75.0,
    }
    base = base_prices.get(symbol, 1.0)
    spread = base * 0.0001
    noise = (np.random.random() - 0.5) * base * 0.002
    bid = round(base + noise, 5)
    ask = round(bid + spread, 5)
    return {
        "symbol": symbol,
        "bid": bid,
        "ask": ask,
        "time": datetime.utcnow().isoformat(),
        "spread": round(spread, 5)
    }


def calculate_stats(trades: List[Trade]) -> dict:
    if not trades:
        return {
            "total": 0, "winning": 0, "losing": 0,
            "win_rate": 0.0, "total_pnl": 0.0,
            "avg_profit": 0.0, "avg_loss": 0.0,
            "best_trade": 0.0, "worst_trade": 0.0,
            "profit_factor": 0.0, "max_drawdown": 0.0
        }
    closed = [t for t in trades if t.status == "closed"]
    if not closed:
        return {
            "total": len(trades), "winning": 0, "losing": 0,
            "win_rate": 0.0, "total_pnl": 0.0,
            "avg_profit": 0.0, "avg_loss": 0.0,
            "best_trade": 0.0, "worst_trade": 0.0,
            "profit_factor": 0.0, "max_drawdown": 0.0
        }
    profits = [t.profit for t in closed]
    winning = [p for p in profits if p > 0]
    losing = [p for p in profits if p < 0]
    total_pnl = sum(profits)
    win_rate = len(winning) / len(closed) * 100 if closed else 0
    gross_profit = sum(winning) if winning else 0
    gross_loss = abs(sum(losing)) if losing else 0
    profit_factor = gross_profit / gross_loss if gross_loss > 0 else 0
    cumulative = np.cumsum(profits)
    running_max = np.maximum.accumulate(cumulative)
    drawdown = running_max - cumulative
    max_dd = float(np.max(drawdown)) if len(drawdown) > 0 else 0
    return {
        "total": len(closed),
        "winning": len(winning),
        "losing": len(losing),
        "win_rate": round(win_rate, 2),
        "total_pnl": round(total_pnl, 2),
        "avg_profit": round(sum(winning) / len(winning), 2) if winning else 0,
        "avg_loss": round(sum(losing) / len(losing), 2) if losing else 0,
        "best_trade": round(max(profits), 2) if profits else 0,
        "worst_trade": round(min(profits), 2) if profits else 0,
        "profit_factor": round(profit_factor, 2),
        "max_drawdown": round(max_dd, 2)
    }


