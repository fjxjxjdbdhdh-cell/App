@app.get("/api/error-db/stats")
async def get_error_stats(
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    patterns = db.query(ErrorPattern).filter(
        ErrorPattern.user_id == current_user.id
    ).all()
    critical = [p for p in patterns if p.is_critical]
    total_loss = sum(p.total_loss for p in patterns)
    by_type = {}
    for p in patterns:
        pt = p.pattern_type
        if pt not in by_type:
            by_type[pt] = {"count": 0, "total_loss": 0}
        by_type[pt]["count"] += p.frequency
        by_type[pt]["total_loss"] += p.total_loss
    return {
        "total_patterns": len(patterns),
        "critical_patterns": len(critical),
        "total_loss_from_errors": round(total_loss, 2),
        "by_type": by_type
    }


