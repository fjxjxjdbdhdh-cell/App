    req: AnalyzeRequest,
    current_user: User = Depends(get_current_user)
):
    import random
    trades = []
    balance = 10000.0
    for i in range(50):
        profit = round(random.gauss(2, 15), 2)
        balance += profit
        trades.append({"trade": i + 1, "profit": profit, "balance": round(balance, 2)})
    wins = len([t for t in trades if t["profit"] > 0])
    return {
        "symbol": req.symbol,
